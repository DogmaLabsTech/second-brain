[Unit]
Description=Second brain: one shared qmd search server for every Claude chat (MCP over HTTP, localhost:8181)

[Service]
# One server keeps the search models loaded once, instead of a copy per Claude chat.
# Graphics card through Vulkan: on the processor, searches stalled for minutes (or failed with
# "Object is disposed") whenever the computer was busy. Models are freed after 5 idle minutes.
Environment=QMD_LLAMA_GPU=vulkan
Environment=QMD_EMBED_PARALLELISM=1
ExecStart=%h/.local/share/mise/shims/qmd mcp --http --port 8181
Nice=10
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
