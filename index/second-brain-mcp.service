[Unit]
Description=Second brain: one shared qmd search server (MCP over HTTP, localhost:8182; chats reach it through second-brain-chat-search on 8181)

[Service]
# One server keeps the search models loaded once, instead of a copy per Claude chat.
Environment=QMD_EMBED_PARALLELISM=1
Environment=PATH=%h/.local/bin:%h/.local/share/mise/shims:/usr/local/bin:/usr/bin
ExecStart=/usr/bin/env qmd mcp --http --port 8182
Nice=10
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
