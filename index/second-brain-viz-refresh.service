[Unit]
Description=Second brain: refresh the Deck's map (viz/tools/refresh.sh; skips when the index did not change)
# Started by second-brain-reindex.service when it is done (second-brain-reindex.service.d/viz.conf), never on its own.

[Service]
Type=oneshot
ExecStart=%h/projects/second-brain/viz/tools/refresh.sh
Nice=10
IOSchedulingClass=idle
CPUSchedulingPolicy=batch
TimeoutStartSec=20min
