{
  "id": "start-claude",
  "label": "Start a Claude on {name}",
  "phrases": ["start a claude on example-game", "open the example-rpg PM", "start working on example", "get a claude going for example-board"],
  "match": "\\b(start|open|launch|get)\\b.*\\b(claude|pm|project manager)\\b|\\bstart (working )?on\\b|\\b(start|get) (a|an) (clot|clod|cloud|clawed|claud|agent) (on|for)\\b",
  "needs_confirm": true,
  "args": {"project": "a repo in ~/projects, or desk", "name": "its plain name", "text": "team job only: the task after the project name, one line"},
  "command": ["{jobs}/bin/open-claude", "{project}"],
  "team_command": ["{jobs}/bin/agent-os-boss", "--repo", "{project}", "--how", "{how}", "--", "{text}"],
  "message": "Opened a Claude on {name}.",
  "team_message": "Prepared the {name} team job. It waits for your go."
}
