#!/usr/bin/env bash
# music <PlayPause|Play|Pause|Next|Previous>: tell the music player (MPRIS over D-Bus; playerctl isn't installed).
# Picks the player that is playing, else the first one. Last line: {"message": "..."}.
set -uo pipefail
action="${1:-PlayPause}"
case "$action" in PlayPause|Play|Pause|Next|Previous) ;; *) echo '{"message":"I can only play, pause, skip or go back."}'; exit 2 ;; esac
mapfile -t players < <(busctl --user list --no-pager --no-legend 2>/dev/null | awk '{print $1}' | grep '^org\.mpris\.MediaPlayer2\.')
if (( ${#players[@]} == 0 )); then
  echo '{"message":"No music app is open, so there is nothing to play."}'; exit 1
fi
pick="${players[0]}"
for p in "${players[@]}"; do
  st="$(busctl --user get-property "$p" /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player PlaybackStatus 2>/dev/null | awk '{print $2}' | tr -d '"')"
  [[ "$st" == Playing ]] && { pick="$p"; break; }
done
if ! busctl --user call "$pick" /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player "$action" 2>/dev/null; then
  echo '{"message":"The music app did not answer."}'; exit 1
fi
name="${pick#org.mpris.MediaPlayer2.}"; name="${name%%.*}"; name="${name^}"
case "$action" in
  Next) msg="Next song on $name." ;; Previous) msg="Back one song on $name." ;;
  Pause) msg="Paused $name." ;; Play) msg="Playing $name." ;;
  *) sleep 0.2
     st="$(busctl --user get-property "$pick" /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player PlaybackStatus 2>/dev/null | awk '{print $2}' | tr -d '"')"
     [[ "$st" == Playing ]] && msg="Playing $name." || msg="Paused $name." ;;
esac
printf '{"message":"%s"}\n' "$msg"
