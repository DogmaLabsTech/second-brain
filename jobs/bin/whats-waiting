#!/usr/bin/env python3
"""whats-waiting: say which Claudes need <user>, the way the bar's Claude light counts them.

Sources (read only):
  - the bar's own list of open Claudes: user.rise core/claudes.sh (beacon files in
    ~/.local/state/claude-beacon/, only Claudes whose process is alive)
  - agent helpers from ~/.local/state/bar-status/status.json (helpers.list), merged with the Claudes
    on the same agent session + pane, exactly like Theme.qml mergeAgents
Last stdout line: {"message": "...", "speak": true}.
"""
import json
import os
import subprocess

HOME = os.path.expanduser("~")
CLAUDES = os.path.join(HOME, ".config/omarchy/plugins/user.rise/core/claudes.sh")
STATUS = os.path.join(HOME, ".local/state/bar-status/status.json")
WORDS = {"permission": "needs your OK", "plan": "has a plan to look at", "answer": "is waiting for you",
         "reply": "asked you something", "stuck": "seems stuck", "question": "has a question"}


def run_json(argv, default):
    try:
        out = subprocess.run(argv, capture_output=True, text=True, timeout=10)
        return json.loads(out.stdout or "null") or default
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return default


def agents():
    claudes = run_json([CLAUDES], []) if os.access(CLAUDES, os.X_OK) else []
    try:
        helpers = json.load(open(STATUS)).get("helpers", {}).get("list", []) or []
    except (OSError, ValueError):
        helpers = []
    out, used = [], set()
    for c in claudes:
        h = None
        if c.get("agentSession") and c.get("agentPane"):
            for j, x in enumerate(helpers):
                if x.get("session") == c["agentSession"] and x.get("pane") == c["agentPane"]:
                    h, _ = x, used.add(j)
                    break
        needs = c.get("state") == "waiting" or bool(h and (h.get("status") == "blocked" or h.get("need")))
        wait = (c.get("waitingFor") or "question") if c.get("state") == "waiting" else \
            ("answer" if h and h.get("status") == "blocked" else (h or {}).get("need", "")) if needs else ""
        working = c.get("state") == "working" or bool(h and h.get("status") == "working")
        out.append({"group": "needs" if needs else "working" if working else "resting",
                    "wait": wait, "name": c.get("folder") or "Claude"})
    for j, h in enumerate(helpers):
        if j in used:
            continue
        needs = h.get("status") == "blocked" or bool(h.get("need"))
        out.append({"group": "needs" if needs else "working" if h.get("status") == "working" else "resting",
                    "wait": "answer" if h.get("status") == "blocked" else h.get("need", ""),
                    "name": h.get("folder") or h.get("agent") or "Helper"})
    return out


def plural(n, one, many):
    return f"{n} {one if n == 1 else many}"


def main():
    a = agents()
    needs = [x for x in a if x["group"] == "needs"]
    working = sum(1 for x in a if x["group"] == "working")
    parts = []
    if needs:
        who = ", ".join(f"{x['name']} ({WORDS.get(x['wait'], 'needs you')})" for x in needs[:4])
        more = f" and {len(needs) - 4} more" if len(needs) > 4 else ""
        parts.append(f"{plural(len(needs), 'Claude needs', 'Claudes need')} you: {who}{more}.")
    if not parts:
        parts.append("Nothing is waiting on you.")
    if working:
        parts.append(f"{plural(working, 'Claude is', 'Claudes are')} still working.")
    print(json.dumps({"message": " ".join(parts), "speak": True}))


if __name__ == "__main__":
    main()
