#!/usr/bin/env bash
# servers <on|off> <name>: switch one hosted thing on or off, the same as a click in the bar's servers list
# (hostctl on|off). Only starts or stops its service: the tailscale link stays as it is. Last line: {"message": "..."}.
set -uo pipefail
action="${1:-}"; site="${2:-}"
case "$action" in on|off) ;; *) echo '{"message":"I can only turn a server on or off."}'; exit 2 ;; esac
# An empty or odd name must never reach hostctl: with no name it acts on every site.
[[ "$site" =~ ^[A-Za-z0-9_-]+$ ]] || { echo '{"message":"I do not know that server."}'; exit 2; }
hostctl="$HOME/.local/bin/hostctl"
line="$("$hostctl" list "$site" 2>/dev/null | head -1)"
label="$(printf '%s' "$line" | cut -f4)"
if [[ -z "$line" || -z "$(printf '%s' "$line" | cut -f3)" ]]; then
  echo '{"message":"I do not know that server."}'; exit 2
fi
"$hostctl" "$action" "$site" >/dev/null 2>&1
for _ in 1 2 3 4 5 6; do
  sleep 0.5
  now="$("$hostctl" list "$site" 2>/dev/null | head -1 | cut -f2)"
  if [[ "$action" == on && "$now" == UP ]] || [[ "$action" == off && "$now" == down ]]; then
    msg="Turned ${label//\"/} $action."; printf '{"message":"%s"}\n' "$msg"; exit 0
  fi
done
printf '{"message":"I asked, but %s did not turn %s."}\n' "${label//\"/}" "$action"; exit 1
