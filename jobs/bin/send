#!/usr/bin/env python3
"""send [--dry] <device> <paths-json> [<name>]: send files to the laptop, the test machine or the iPhone.

  laptop  ~/.local/bin/send-to-laptop (override: env BRAIN_SEND_BIN). One file goes as it is; several are
          copied into one folder ("<name> - <date>") first, so the laptop gets one folder and one notice.
          They land in Downloads/From desktop there. Stage folders older than 14 days are deleted.
  testbox     scp -q -o BatchMode=yes -o ConnectTimeout=10 <file> testbox:Downloads/   (one per file)
  phone   tailscale file cp <file> owners-iphone:
A folder is zipped first for the test machine and the iPhone. Everything is checked again (jobs/sendfiles.py).
--dry prints what would run and sends nothing. Last line: {"message": "..."}.
"""
import datetime
import json
import os
import shutil
import subprocess
import sys
import time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
import sendfiles as sf  # noqa: E402

HOME = os.path.expanduser("~")
STATE = os.path.join(HOME, ".local", "state", "send-to-laptop")
STAGE = os.path.join(STATE, "files")
LAPTOP_STATUS = os.path.join(HOME, ".local", "state", "bar-status", "laptop.json")
BUDGET = 50  # seconds; jobs.run stops a job at 60


def say(message, code=0):
    print(json.dumps({"message": message}))
    return code


def plural(n, word):
    return f"{n} {word}" + ("" if n == 1 else "s")


def laptop_on():
    """False when the laptop's own status file says it is off, asleep or has lost the mount."""
    try:
        with open(LAPTOP_STATUS) as f:
            s = json.load(f)
        return bool(s.get("mounted")) and time.time() - float(s.get("at", 0)) <= 180
    except (OSError, ValueError, TypeError):
        return False


def tidy_stage_folders(now=None):
    """Delete the folders this script made (named '<name> - YYYY-MM-DD[ HHMM]') once they are 14 days old."""
    import re
    now = now or time.time()
    try:
        names = os.listdir(STAGE)
    except OSError:
        return
    for n in names:
        p = os.path.join(STAGE, n)
        if re.search(r" - \d{4}-\d{2}-\d{2}( \d{4})?$", n) and os.path.isdir(p) and not os.path.islink(p) \
                and now - os.path.getmtime(p) > 14 * 86400:
            shutil.rmtree(p, ignore_errors=True)


def stage(paths, name):
    """Copy several files into one new folder; returns its path."""
    today = datetime.date.today().isoformat()
    safe = "".join(c for c in name if c.isalnum() or c in " .&'-_").strip() or "Files"
    folder = os.path.join(STAGE, f"{safe} - {today}")
    if os.path.exists(folder):
        folder += " " + datetime.datetime.now().strftime("%H%M")
    n = 2
    base = folder
    while os.path.exists(folder):
        folder = f"{base}-{n}"
        n += 1
    os.makedirs(folder)
    for p in paths:
        dest = os.path.join(folder, os.path.basename(p))
        k = 2
        while os.path.exists(dest):
            stem, ext = os.path.splitext(os.path.basename(p))
            dest = os.path.join(folder, f"{stem} ({k}){ext}")
            k += 1
        if os.path.isdir(p):
            # symlinks=True copies a link as a link, never what it points to (check_send refuses links anyway).
            shutil.copytree(p, dest, symlinks=True)
        else:
            shutil.copy2(p, dest)
    return folder


def online(host):
    """True / False from `tailscale status --json`, None when it can't be read."""
    try:
        out = subprocess.run(["tailscale", "status", "--json"], capture_output=True, text=True, timeout=8).stdout
        peers = json.loads(out or "{}").get("Peer") or {}
    except (OSError, subprocess.TimeoutExpired, ValueError):
        return None
    for p in peers.values():
        name = ((p.get("DNSName") or "").split(".")[0] or p.get("HostName") or "").lower()
        if name == host:
            return p.get("Online") is True
    return False


def zip_folder(path):
    """A zip of the folder in the stage area; returns the zip's path. -y stores a link as a link."""
    os.makedirs(STAGE, exist_ok=True)
    base = os.path.basename(path.rstrip("/"))
    out = os.path.join(STAGE, f"{base} - {datetime.date.today().isoformat()} {datetime.datetime.now():%H%M%S}.zip")
    subprocess.run(["zip", "-qry", out, base], cwd=os.path.dirname(path.rstrip("/")), check=True, timeout=40)
    return out


def main(argv):
    dry = "--dry" in argv
    argv = [a for a in argv if a != "--dry"]
    if len(argv) < 2:
        return say("The send job was missing its details, so I sent nothing.", 2)
    try:
        paths = json.loads(argv[1])
        device, paths, info = sf.check_send(argv[0], paths)
    except (ValueError, TypeError) as why:
        return say(f"I didn't send it: {why}.", 2)
    name = argv[2] if len(argv) > 2 and argv[2].strip() else "Files"
    dev = sf.DEVICES[device]
    n = len(paths)
    what = os.path.basename(paths[0]) if n == 1 else plural(n, "file")
    started = time.monotonic()

    if device == "laptop":
        send_bin = os.environ.get("BRAIN_SEND_BIN") or os.path.join(HOME, ".local", "bin", "send-to-laptop")
        if not dry:
            tidy_stage_folders()
        target = paths[0]
        if n > 1:
            target = os.path.join(STAGE, f"{name} - {datetime.date.today().isoformat()}") if dry else stage(paths, name)
        cmd = [send_bin, target]
        if dry:
            print("would run: " + json.dumps(cmd))
            return say(f"Dry run: would send {what} to the laptop" + (f" as one folder, {os.path.basename(target)}" if n > 1 else "") + ".")
        try:
            out = subprocess.run(cmd, capture_output=True, text=True, timeout=BUDGET)
        except (OSError, subprocess.TimeoutExpired) as why:
            return say(f"I couldn't send it to the laptop: {why}.", 1)
        if out.returncode != 0:
            err = (out.stderr or out.stdout).strip().splitlines()
            return say("I couldn't send it to the laptop" + (f": {err[-1][:120]}." if err else "."), 1)
        folder = f" as the folder {os.path.basename(target)}" if n > 1 else ""
        if not laptop_on():
            return say(f"The laptop looks off or asleep. I lined up {what}{folder}, and it will get "
                       "them when it's on.")
        return say(f"Sent {what} to the laptop{folder}. {'It' if n == 1 else 'They'}'ll be in Downloads, in the "
                   "From desktop folder, in a few seconds.")

    # the test machine and the iPhone
    if not dry:
        state = online(dev["host"])
        if state is False:
            return say(f"{dev['say'][:1].upper() + dev['say'][1:]} isn't on right now, so I didn't send anything.", 1)
    items = []
    for p in paths:
        if os.path.isdir(p):
            if dry:
                items.append(os.path.join(STAGE, os.path.basename(p) + " - <date>.zip"))
                continue
            try:
                items.append(zip_folder(p))
            except (OSError, subprocess.SubprocessError):
                return say(f"I couldn't zip the folder {os.path.basename(p)}.", 1)
        else:
            items.append(p)
    cmds = [(["scp", "-q", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", f, f"{dev['host']}:Downloads/"]
             if device == "testbox" else ["tailscale", "file", "cp", f, f"{dev['host']}:"]) for f in items]
    if dry:
        for c in cmds:
            print("would run: " + json.dumps(c))
        return say(f"Dry run: would send {what} to {dev['say']}.")
    for c in cmds:
        left = BUDGET - (time.monotonic() - started)
        if left <= 1:
            return say("That's taking too long, so I stopped. Try fewer or smaller files.", 1)
        try:
            out = subprocess.run(c, capture_output=True, text=True, timeout=left)
        except subprocess.TimeoutExpired:
            return say("That's taking too long, so I stopped. Try fewer or smaller files.", 1)
        except OSError as why:
            return say(f"I couldn't send it to {dev['say']}: {why}.", 1)
        if out.returncode != 0:
            err = (out.stderr or out.stdout).strip().splitlines()
            return say(f"I couldn't send {os.path.basename(c[-2])} to {dev['say']}" +
                       (f": {err[-1][:120]}." if err else "."), 1)
    where = "It's in the test machine's Downloads folder." if device == "testbox" else \
        "It's in the Files app, in the Tailscale folder."
    return say(f"Sent {what} to {dev['say']}. {where}")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
