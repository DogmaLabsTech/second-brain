#!/usr/bin/env python3
"""agent-os-start [--job start-job --repo <project>] --how voice|typed -- "<words>": prepare a team job with agent-os.

Run by `brain job run remember-fix|start-job` after <user>'s Yes on the island card. It only prepares: the job waits
for <user>'s yes at the desk (go.md, a file only he writes); nothing is started, built or pushed from here.
  remember-fix: `agent-os boss prepare --remember --how <how> -- "<his words>"`. agent-os finds the item on his
    remember list and prepares an ordinary team job for it.
      exit 0 + a `job:` line  -> "Prepared the fix from your remember list. It waits for your go."
      exit 3 + a `job:` line  -> several items fit: the job waits for his pick in the office ("which one?").
      anything else           -> "I couldn't start that job."
  start-job: the same as start-claude's team job (jobs/bin/agent-os-boss, one copy of its checks):
    `agent-os boss prepare --repo <project> --how <how> -- "<task>"` -> "Prepared the <Project> team job. ..."
It prints one JSON line for the island: {"message": ..., "speak": true}. The words are always one argument after
`--` (never through a shell). If agent-os fails or takes longer than PREPARE_SECONDS it says it couldn't.

Environment:
  AGENT_OS_BIN            which agent-os (default: `agent-os` on PATH, else ~/agent-os/bin/agent-os)
  AGENT_OS_HOME, AGENT_OS_REMEMBER_LIST
                          agent-os reads them itself (they pass through)
"""
import importlib.machinery
import importlib.util
import json
import os
import re
import shutil
import subprocess
import sys

HOME = os.path.expanduser("~")
HERE = os.path.dirname(os.path.abspath(__file__))
DEFAULT_BIN = os.path.join(HOME, "agent-os", "bin", "agent-os")
PREPARED = "Prepared the fix from your remember list. It waits for your go."
WHICH_ONE = "More than one thing on your remember list fits. Pick which one in the office, then it waits for your go."
FAILED = "I couldn't start that job."
PREPARE_SECONDS = 60     # it may look up the repo in the brain


def say(message, code):
    print(json.dumps({"message": message, "speak": True}))
    return code


def agent_os_bin():
    return os.path.abspath(os.environ.get("AGENT_OS_BIN") or shutil.which("agent-os") or DEFAULT_BIN)


def ok_words(text):
    return bool(text.strip()) and not re.search(r"[\x00-\x08\x0a-\x1f\x7f]", text) and len(text) <= 500 \
        and not text.lstrip().startswith("-")


def prepare_remembered(how, text):
    """`agent-os boss prepare --remember`: (message, exit code) for the island."""
    try:
        out = subprocess.run([agent_os_bin(), "boss", "prepare", "--remember", "--how", how, "--", text],
                             capture_output=True, text=True, timeout=PREPARE_SECONDS, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired):
        return FAILED, 1
    has_job = any(re.match(r"^job: /\S", line.strip()) for line in out.stdout.splitlines())
    if has_job and out.returncode == 0:
        return PREPARED, 0
    if has_job and out.returncode == 3:
        return WHICH_ONE, 0
    return FAILED, 1


def boss_main(argv):
    """start-job runs agent-os-boss's own main (its project check, its message)."""
    path = os.path.join(HERE, "agent-os-boss")
    loader = importlib.machinery.SourceFileLoader("agent_os_boss", path)
    spec = importlib.util.spec_from_loader("agent_os_boss", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod.main(argv)


def main(argv):
    if argv[:2] == ["--job", "start-job"]:
        if len(argv) != 8 or argv[2] != "--repo":
            return say(FAILED, 2)
        return boss_main(argv[2:])
    if len(argv) != 4 or argv[0] != "--how" or argv[1] not in ("voice", "typed") or argv[2] != "--" \
            or not ok_words(argv[3]):
        return say(FAILED, 2)
    return say(*prepare_remembered(argv[1], argv[3]))


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
