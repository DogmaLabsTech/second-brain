#!/usr/bin/env python3
"""open-claude <project>: open a terminal with Claude in that project's folder (start-claude's command).

<project> is a folder name in ~/projects, or `desk` for ~/agent-os. Replaces the project manager's
`pm open <project> --launch` (the PM and agent were retired, one brain 2026-10-28). The terminal is Omarchy's
(xdg-terminal-exec), started apart from this process so the island's job runner doesn't wait for it.
Exit 2 with a plain line when the folder is not there; nothing is opened then.
"""
import os
import shutil
import subprocess
import sys

HOME = os.path.expanduser("~")
PROJECTS = os.path.join(HOME, "projects", "Projects")


def folder(project):
    if project == "desk":
        return os.path.join(HOME, "agent-os")
    if not project or "/" in project or project.startswith("."):
        return None
    return os.path.join(PROJECTS, project)


def argv_for(path):
    term = ["xdg-terminal-exec", f"--dir={path}", "claude"]
    return ["uwsm-app", "--"] + term if shutil.which("uwsm-app") else term


def main(args):
    path = folder(args[0] if args else "")
    if not path or not os.path.isdir(path):
        print(f"open-claude: no project folder for {args[0] if args else 'nothing'}", file=sys.stderr)
        return 2
    subprocess.Popen(argv_for(path), cwd=path, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
