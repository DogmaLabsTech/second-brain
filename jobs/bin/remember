#!/usr/bin/env python3
"""remember "<text>": add one dated line to ~/brain/inbox/remembered.md (made if missing).

The file is in the brain's `computer` collection, so the hourly reindex makes it searchable.
Prints {"message": ...} as its last line. Never rewrites earlier lines (append only).
"""
import json
import os
import re
import sys
import time

PATH = os.path.expanduser(os.environ.get("BRAIN_REMEMBER_FILE", "~/brain/inbox/remembered.md"))
HEAD = """# Remembered

Things <user> asked the brain island to remember ("Hey Claude, remember that ..."), one dated line
each, newest last, each with a tick box (Obsidian Tasks; a ticked item is done and no longer offered). Written by `brain job run remember` (second-brain `jobs/bin/remember`); read into
the second brain at the next hourly reindex. Fine to tidy by hand.

"""
PROJECTS = os.path.expanduser(os.environ.get("BRAIN_PROJECTS_DIR", "~/projects"))
# Project folders whose names are ordinary English words or phrases: said in a sentence they usually
# mean the word ("check the example levels"), so they are never tagged by guessing. A said tag still stays.
COMMON_WORDS = {"bullpen", "decider", "digest", "expedition", "factory", "example-flights", "example", "example-trader", "example-board",
                "example-power", "reimagine-it"}
SAID = re.compile(r"\(\s*repo\s*:\s*([^()]*?)\s*\)", re.I)
NAME = re.compile(r"[a-z0-9][a-z0-9._-]{0,63}")


def said_tag(text):
    """(text without the first '(repo: x)', x) or (text, None). Any further tags are dropped."""
    m = SAID.search(text)
    tag = re.sub(r"\s+", "-", m.group(1).strip().lower()) if m else ""
    if not NAME.fullmatch(tag):   # only folder-like names ("omarchy setup" -> omarchy-setup); anything else stays
        return (SAID.sub(lambda k: "(repo %s)" % k.group(1), text) if m else text), None   # as words, not a tag
    rest = SAID.sub(" ", text[:m.start()] + " " + text[m.end():])
    return " ".join(rest.split()), tag


def auto_tag(text):
    """The longest project folder whose whole name (dashes = spaces or dashes) is in the text, or None."""
    try:
        names = [n for n in os.listdir(PROJECTS) if not n.startswith(".") and os.path.isdir(os.path.join(PROJECTS, n))]
    except OSError:
        return None
    for n in sorted(names, key=len, reverse=True):
        if n.lower() in COMMON_WORDS:
            continue
        words = [re.escape(w) for w in re.split(r"[-_]+", n.lower()) if w]
        if words and re.search(r"(?<![a-z0-9])" + r"[ _-]+".join(words) + r"(?![a-z0-9])", text.lower()):
            return n
    return None


def main():
    text = " ".join(" ".join(sys.argv[1:]).split()).strip()
    if not text:
        print(json.dumps({"message": "There was nothing to remember."}))
        return 1
    text, tag = said_tag(text)
    text = text[:500]
    tag = tag or auto_tag(text)
    if tag:
        text += f" (repo: {tag})"
    os.makedirs(os.path.dirname(PATH), exist_ok=True)
    new = not os.path.exists(PATH)
    with open(PATH, "a") as f:
        if new:
            f.write(HEAD)
        f.write(f"- [ ] {time.strftime('%Y-%m-%d %H:%M')}: {text}\n")   # a tick box for Obsidian Tasks (2026-10-18)
    print(json.dumps({"message": "Got it. I wrote it in your remembered list."}))
    return 0


if __name__ == "__main__":
    sys.exit(main())
