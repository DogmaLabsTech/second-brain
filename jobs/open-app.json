{
  "id": "open-app",
  "label": "Open {name}",
  "phrases": ["open spotify", "launch discord", "open vs code on my second monitor", "open a terminal", "switch to obsidian", "open the browser"],
  "match": "^(please )?((can|could|would|will) you (please )?)?(open|launch|start|run|fire up|switch to|bring up|pull up)\\b",
  "order": 80,
  "needs_confirm": false,
  "args": {"app": "an installed app's .desktop id, or @browser, @terminal, @files, @editor", "name": "its name", "monitor": "optional: other, left, right, top, bottom or a screen name: open it there"},
  "command": ["{jobs}/bin/desktop", "app", "{app}", "{monitor}"],
  "message": "Opened {name}."
}
