# What stays on your computer and never goes to GitHub. Ignored files are not deleted: they stay and keep working.

# --- Python and Node leftovers ---
__pycache__/
*.pyc
.venv/
venv/
*-venv/
.pytest_cache/
node_modules/

# --- Editor and tool state ---
.obsidian/
.playwright-mcp/
.claude/settings.local.json
.crabbox/

# --- Secrets, just in case (none are kept in this folder) ---
.env
.env.*
.secrets/
*.pem
*.key
id_*

# --- Your private words and data made from your own notes ---
deciders/private.json
ask/race-results*.jsonl
ask/race-questions.tsv
eval/heldout.jsonl
eval/memory-heldout.jsonl
eval/labels/

# --- Maps, logs and recordings made on your computer ---
deck/data.js
deck/*.jsonl
deck/talk-log*
*.wav
*.mp3
*.flac
*.ogg

# --- Big model files ---
*.npy
*.pt
*.pth
*.ckpt
*.safetensors
*.gguf
*.onnx
