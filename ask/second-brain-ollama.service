[Unit]
Description=Ollama for the second brain (local writer for brain ask), this user only
After=network.target

[Service]
ExecStart=/usr/bin/ollama serve
# Models live on the big drive (~/.ollama is a link to /mnt/backup/home/.ollama).
Environment=OLLAMA_MODELS=/mnt/backup/home/.ollama/models
Environment=OLLAMA_HOST=127.0.0.1:11434
# Keep the writer loaded for 30 idle minutes, one model at a time, one request at a time.
Environment=OLLAMA_KEEP_ALIVE=5m
Environment=OLLAMA_MAX_LOADED_MODELS=1
Environment=OLLAMA_NUM_PARALLEL=1
# The writer runs on the processor, never the graphics card (<user>, 2026-10-18): the card is for the screen and the
# brain's search model; the local decider runs on the test machine. Ollama reaches the card two ways: CUDA (hidden with -1; it treats an empty value as unset) and Vulkan (off).
Environment=CUDA_VISIBLE_DEVICES=-1
Environment=OLLAMA_VULKAN=0
Environment=GGML_VK_VISIBLE_DEVICES=-1
Nice=5
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
